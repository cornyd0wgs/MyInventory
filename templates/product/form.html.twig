{% extends 'base.html.twig' %}

{% block title %}{{ mode == 'new' ? 'Add product' : 'Edit product' }} — My Inventory Helper{% endblock %}

{% block body %}
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="page-title">{{ mode == 'new' ? 'Add product' : 'Edit ' ~ product.name }}</h1>
                <p class="text-secondary mb-0">Prices are stored as decimal strings with two decimal places.</p>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                {{ form_start(form) }}
                    <div class="card-body">
                        {{ form_widget(form) }}
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <button class="btn btn-primary" type="submit">
                            <i class="ti ti-device-floppy me-1"></i>{{ mode == 'new' ? 'Add product' : 'Save changes' }}
                        </button>
                        <a class="btn btn-outline-secondary" href="{{ path('app_product_index') }}">Cancel</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
