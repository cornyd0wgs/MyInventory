{% extends 'base.html.twig' %}

{% block title %}Record Stock-In — My Inventory Helper{% endblock %}

{% block body %}
    {% set proto = form.items.vars.prototype %}
    {% set protoHtml %}
        <div class="stock-item-row row g-2 align-items-end border-bottom py-2">
            <div class="col-md-5">{{ form_row(proto.product) }}</div>
            <div class="col-md-2">{{ form_row(proto.quantity) }}</div>
            <div class="col-md-2">{{ form_row(proto.unitCost) }}</div>
            <div class="col-md-2">
                <div class="form-label">Subtotal</div>
                <div class="form-control-plaintext" data-subtotal>₱0.00</div>
            </div>
            <div class="col-md-1">
                <button class="btn btn-outline-danger btn-sm" type="button" data-remove-stock-item aria-label="Remove item">
                    <i class="ti ti-trash"></i>
                </button>
            </div>
        </div>
    {% endset %}

    <div class="page-header d-print-none">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="page-title">Record Stock-In</h1>
                <p class="text-secondary mb-0">Quantities and costs are computed on the server with decimal arithmetic.</p>
            </div>
            <div class="col-auto ms-auto">
                <a class="btn btn-outline-secondary" href="{{ path('app_stock_index') }}">Stock-In history</a>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-11">
            <div class="card" data-stock-in data-lookup-url="{{ path('app_stock_lookup') }}">
                {{ form_start(form) }}
                    <div class="card-body">
                        {{ form_errors(form) }}
                        <div class="row g-3">
                            <div class="col-md-6">{{ form_row(form.referenceNumber) }}</div>
                            <div class="col-md-6">{{ form_row(form.supplier) }}</div>
                        </div>

                        <div class="row g-3 align-items-end mt-1">
                            <div class="col-md-8">{{ form_row(form.barcode) }}</div>
                            <div class="col-md-4">
                                <button class="btn btn-outline-primary mb-3" type="button" data-barcode-add>
                                    <i class="ti ti-barcode me-1"></i>Add scanned item
                                </button>
                            </div>
                        </div>
                        <div class="alert alert-danger d-none py-2" data-barcode-error role="alert"></div>

                        <hr class="my-3">

                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h2 class="h5 mb-0">Items</h2>
                            <button class="btn btn-outline-secondary btn-sm" type="button" data-add-stock-item>
                                <i class="ti ti-plus me-1"></i>Add row
                            </button>
                        </div>

                        {{ form_errors(form.items) }}
                        <div class="border-top" data-stock-items data-prototype="{{ protoHtml|e('html_attr') }}" data-index="{{ form.items|length }}">
                            {% for item in form.items %}
                                <div class="stock-item-row row g-2 align-items-end border-bottom py-2">
                                    <div class="col-md-5">{{ form_row(item.product) }}</div>
                                    <div class="col-md-2">{{ form_row(item.quantity) }}</div>
                                    <div class="col-md-2">{{ form_row(item.unitCost) }}</div>
                                    <div class="col-md-2">
                                        <div class="form-label">Subtotal</div>
                                        <div class="form-control-plaintext" data-subtotal>₱{{ item.vars.value.subtotal|default('0.00') }}</div>
                                    </div>
                                    <div class="col-md-1">
                                        <button class="btn btn-outline-danger btn-sm" type="button" data-remove-stock-item aria-label="Remove item">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>

                        <div class="mt-3">{{ form_row(form.updateCostPrice) }}</div>
                        <div class="mt-3">{{ form_row(form.notes) }}</div>
                        {{ form_rest(form) }}
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <button class="btn btn-primary" type="submit">
                            <i class="ti ti-device-floppy me-1"></i>Record stock-in
                        </button>
                        <a class="btn btn-outline-secondary" href="{{ path('app_stock_index') }}">Cancel</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
